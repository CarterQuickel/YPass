# Central YPass server URL (not localhost unless YPass runs on this computer)
KIOSK_SERVER_URL=https://your-ypass-server.example
KIOSK_PORT=4177
KIOSK_HEARTBEAT_MS=30000

# Normal Windows sign-in startup. Set false when using Windows Shell Launcher.
KIOSK_START_ON_LOGIN=true

# Set true only when Windows Shell Launcher is configured for this kiosk account.
KIOSK_SHELL_LAUNCHER=false
